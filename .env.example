# --- Configuration de l'Application ---
APP_NAME="EcoScan AI/RAG"
ENVIRONMENT="development"
# Générez une clé aléatoire et renseignez exactement la même valeur dans
# AI_SERVICE_INTERNAL_TOKEN du .env du backend Django.
INTERNAL_TOKEN=""

# --- Intégration Backend Django ---
# Sous WSL, `bash run-local-wsl.sh` determine la passerelle de l'hote Windows.
DJANGO_API_URL="http://localhost:8000"
# A definir si Django attend un autre Host via une passerelle reseau.
DJANGO_HOST_HEADER=""
DJANGO_INTERNAL_TOKEN=replace-with-the-same-DJANGO_INTERNAL_TOKEN-as-backend
DJANGO_TIMEOUT=15.0

# --- Stockage RAG et Fichiers ---
RAG_STORE_PATH="./data/rag_store.json"
MAX_UPLOAD_MB=50

# --- Clés d'API Externes ---
HUGGINGFACE_API_KEY="hf_votre_jeton_huggingface_ici"
GROQ_API_KEY="gsk_votre_cle_groq_ici"
OPENAI_API_KEY="sk-votre_cle_openai_ici"
OPENAI_API_BASE="https://api.openai.com/v1"

# --- Chaînes de Secours (Failover) ---
TEXT_MODEL_CHAIN="groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openai:gpt-4.1-mini"
VISION_MODEL_CHAIN="groq:qwen/qwen3.6-27b"
AUDIO_TRANSCRIPTION_CHAIN="groq:whisper-large-v3"

MIN_BACKUPS_RECOMMANDES=2