# --- Configuration de l'Application ---
APP_NAME="EcoScan AI/RAG"
ENVIRONMENT="development"
INTERNAL_TOKEN="votre-jeton-secret-interne-ici"

# --- Intégration Backend Django ---
DJANGO_API_URL="http://localhost:8000"
DJANGO_INTERNAL_TOKEN="votre-jeton-django-interne-ici"
DJANGO_TIMEOUT=15.0

# --- Stockage RAG et Fichiers ---
RAG_STORE_PATH="./data/rag_store.json"
MAX_UPLOAD_MB=50

# --- Clés d'API Externes ---
HUGGINGFACE_API_KEY="hf_votre_jeton_huggingface_ici"
GROQ_API_KEY="gsk_votre_cle_groq_ici"
OPENAI_API_KEY="sk-votre_cle_openai_ici"
OPENAI_API_BASE=""

# --- Chaînes de Secours (Failover) ---
TEXT_MODEL_CHAIN="groq:llama-3.3-70b-versatile,huggingface:meta-llama/Llama-3.3-70B-Instruct,huggingface:Qwen/Qwen2.5-72B-Instruct"
VISION_MODEL_CHAIN="groq:llama-3.2-11b-vision-preview,huggingface:meta-llama/Llama-3.2-11B-Vision-Instruct"
AUDIO_TRANSCRIPTION_CHAIN="local:faster-whisper,local:AIHubSN/Kiriku-Wolof-ASR"

MIN_BACKUPS_RECOMMANDES=2